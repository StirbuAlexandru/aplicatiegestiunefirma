<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_gradient_login"
    android:padding="32dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_info"
                app:tint="@color/primary_blue"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvPinTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seteaza PIN"
                android:textSize="22sp"
                android:textColor="@color/text_main"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="32dp" />

            <TextView
                android:id="@+id/tvPinDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○  ○  ○  ○"
                android:textSize="36sp"
                android:letterSpacing="0.3"
                android:textColor="@color/primary_blue"
                android:layout_marginBottom="40dp" />

            <!-- Keypad Row 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="16dp">
                <Button android:id="@+id/btn1" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="1" android:textSize="22sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
                <Button android:id="@+id/btn2" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="2" android:textSize="22sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
                <Button android:id="@+id/btn3" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="3" android:textSize="22sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
            </LinearLayout>
            <!-- Row 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="16dp">
                <Button android:id="@+id/btn4" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="4" android:textSize="22sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
                <Button android:id="@+id/btn5" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="5" android:textSize="22sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
                <Button android:id="@+id/btn6" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="6" android:textSize="22sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
            </LinearLayout>
            <!-- Row 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="16dp">
                <Button android:id="@+id/btn7" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="7" android:textSize="22sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
                <Button android:id="@+id/btn8" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="8" android:textSize="22sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
                <Button android:id="@+id/btn9" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="9" android:textSize="22sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
            </LinearLayout>
            <!-- Row 4 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center">
                <Button android:id="@+id/btnPinCancel" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="X" android:textSize="18sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
                <Button android:id="@+id/btn0" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="0" android:textSize="22sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
                <Button android:id="@+id/btnPinDelete" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginHorizontal="8dp"
                    android:text="⌫" android:textSize="22sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="36dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
